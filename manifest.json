{
  "schema": "lattice.plugin.manifest.v2",
  "id": "example.lattice-plugin",
  "name": "Lattice Bundle Reference Plugin",
  "type": "system",
  "capabilities": [
    "network:plan"
  ],
  "version": "0.2.1-alpha.2",
  "publisher": "latticenet",
  "signature_ed25519": "xRTsmmMXCPVUjCsNN9M3xhpU0wFYf5xWnsQPAY0tRuUQP6G5Q2UTTnDpyJ/1RJPwNB6K7qh1PpDx6ojrknowAw==",
  "bundle": {
    "format": "tar+gzip",
    "digest_sha256": "4fdc4d878e97f2d1ab1d36af713fd9a954607098468faee0b57a8f710a28b484"
  },
  "runtime": {
    "protocol": "stdio-json-v1",
    "entrypoints": {
      "linux/amd64": "bin/linux-amd64/plugin",
      "linux/arm64": "bin/linux-arm64/plugin"
    }
  },
  "ui_runtime": {
    "mode": "sandbox",
    "entrypoint": "ui/index.html",
    "bridge_version": "1"
  },
  "compatibility": {
    "server": "\u003e=0.2.1",
    "dashboard_host": "\u003e=1",
    "runtime_protocol": "\u003e=1"
  },
  "ui": {
    "nav": [
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Reference Plugin",
        "route": "reference",
        "icon": "Blocks",
        "scopes": [
          "network:plan"
        ]
      }
    ],
    "views": [
      {
        "route": "reference",
        "title": "Reference Plugin",
        "kind": "sandbox"
      }
    ]
  },
  "interfaces": [
    {
      "service": "example.lattice-plugin/reference",
      "methods": [
        {
          "name": "describe",
          "effect": "read",
          "scopes": [
            "network:plan"
          ]
        },
        {
          "name": "plan",
          "effect": "plan",
          "scopes": [
            "network:plan"
          ]
        }
      ]
    }
  ]
}
