{
  "schema": "lattice.plugin.manifest.v2",
  "id": "example.lattice-plugin",
  "name": "Lattice Bundle Reference Plugin",
  "type": "system",
  "capabilities": [
    "network:plan",
    "http:operator-target"
  ],
  "version": "0.2.1-alpha.6",
  "publisher": "latticenet",
  "signature_ed25519": "pjJn30lKWvnKK8Pf0ROgij0JaHn9e+Rl/HwgkY37um+vSYZ7UsPzBguEOnvBPSQZWkA+AmAVkr0xepROKT4TBQ==",
  "bundle": {
    "format": "tar+gzip",
    "digest_sha256": "0a806be828bb55cfd33e9a935bb7fceb3ed6a164fbf08a547388f615073d4bb2"
  },
  "runtime": {
    "protocol": "stdio-json-v1",
    "entrypoints": {
      "linux/amd64": "bin/linux-amd64/plugin",
      "linux/arm64": "bin/linux-arm64/plugin"
    }
  },
  "ui_runtime": {
    "mode": "sandbox",
    "entrypoint": "ui/index.html",
    "bridge_version": "1"
  },
  "compatibility": {
    "server": "\u003e=0.2.1",
    "dashboard_host": "\u003e=1",
    "runtime_protocol": "\u003e=1"
  },
  "ui": {
    "nav": [
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Reference Plugin",
        "route": "reference",
        "icon": "Blocks",
        "scopes": [
          "network:plan"
        ]
      }
    ],
    "views": [
      {
        "route": "reference",
        "title": "Reference Plugin",
        "kind": "sandbox"
      }
    ]
  },
  "interfaces": [
    {
      "service": "example.lattice-plugin/reference",
      "methods": [
        {
          "name": "describe",
          "effect": "read",
          "scopes": [
            "network:plan"
          ]
        },
        {
          "name": "plan",
          "effect": "plan",
          "scopes": [
            "network:plan"
          ]
        },
        {
          "name": "probe_operator_target",
          "effect": "read",
          "scopes": [
            "network:plan"
          ],
          "operator_target_fields": [
            "base_url"
          ]
        }
      ],
      "backing": "runtime"
    }
  ]
}
